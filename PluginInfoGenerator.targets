<Project>
  <!-- Based on https://github.com/UltraModding/UltraModding.Templates/blob/master/UltraModding.PluginInfoGenerator/UltraModding.PluginInfoGenerator.targets -->
  
  <Target Name="GeneratePluginInfo" BeforeTargets="BeforeCompile;CoreCompile" Outputs="$(IntermediateOutputPath)GeneratedFile.cs">
    <PropertyGroup>
      <GeneratedText>
        <![CDATA[
namespace $(RootNamespace)%3B

public partial class ObjPlugin
{
    public static new class Info
    {
        public const string GUID = "$(GUID)"%3B
        public const string Name = "$(AssemblyName)"%3B
        public const string Version = "$(Version)"%3B

#if DEBUG
        public const bool Debug = true%3B
#else
        public const bool Debug = false%3B
#endif
    }
}
      ]]>
      </GeneratedText>
      <GeneratedFilePath>$(IntermediateOutputPath)ObjImporterPluginInfo.cs</GeneratedFilePath>
    </PropertyGroup>

    <ItemGroup>
      <Compile Include="$(GeneratedFilePath)" />
      <FileWrites Include="$(GeneratedFilePath)" />
    </ItemGroup>
    
    <WriteLinesToFile Lines="$(GeneratedText)" File="$(GeneratedFilePath)" WriteOnlyWhenDifferent="true" Overwrite="true" />
  </Target>
</Project>
